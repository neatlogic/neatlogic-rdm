  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ]
    },
    {
      "name": "idx_object_id",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "project_id",
        "app_id",
        "object_type",
        "object_id",
        "parent_id",
        "id"
      ]
    },
    {
      "name": "idx_parent_id",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "parent_id",
        "id"
      ]
    },
    {
      "name": "idx_start_time",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "start_time"
      ]
    },
    {
      "name": "idx_status_start",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "status",
        "start_time"
      ]
    }
