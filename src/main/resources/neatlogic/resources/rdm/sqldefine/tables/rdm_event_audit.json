    {
      "name": "parent_id",
      "type": "bigint",
      "description": "父执行审计id"
    },
    {
      "name": "issue_id",
      "type": "bigint",
      "description": "历史需求id，仅用于旧审计迁移"
    },
    {
      "name": "object_type",
      "type": "varchar(100)",
      "description": "业务对象类型"
    },
    {
      "name": "object_id",
      "type": "varchar(255)",
      "description": "业务对象标识"
    },
    {
      "name": "project_id",
      "type": "bigint",
      "description": "项目id"
    },
    {
      "name": "app_id",
      "type": "bigint",
      "description": "应用id"
    },
    {
      "name": "event",
      "type": "varchar(100)",
      "description": "事件标识"
    },
    {
      "name": "handler",
      "type": "varchar(100)",
      "description": "插件唯一标识"
    },
    {
      "name": "handler_name",
      "type": "varchar(200)",
      "description": "处理器配置名称快照"
    },
    {
      "name": "event_handler_id",
      "type": "bigint",
      "description": "处理器配置id"
    },
    {
      "name": "start_time",
      "type": "datetime(3)",
      "description": "执行开始时间"
    },
    {
      "name": "end_time",
      "type": "datetime(3)",
      "description": "执行结束时间"
    },
    {
      "name": "status",
      "type": "varchar(50)",
      "description": "执行状态"
    },
    {
      "name": "error",
